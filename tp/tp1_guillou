function maxi(n,m){
    if(n>m){
        return n;
    }
    return m;
}

//Exercice 2:

function abs(n){
    if(n<=0){
        return n*-1;
    }
    return n;
}

//Exercice 3:

function harm(n){
    if(n==0){
        return 0;
    }
    return 1/n + harm(n-1);
}

